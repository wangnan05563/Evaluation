# ─── 依赖 ────────────────────────────────────────────────────────────
node_modules/
.npm/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── 构建产物与发布物 ────────────────────────────────────────────────
# 可重建产物统一落 release/（构建入口 scripts\构建打包.bat 每轮先清空 release 再重建）：
#   release/exe/          PyInstaller sidecar 成品（electron-builder extraResources 引用）
#   release/build/        PyInstaller workpath（.toc/.pkg/PYZ 等中间缓存）
#   release/tmp/          测试/文档采集的一次性数据、浏览器 profile 与孤立副本
#   release/logs/         构建日志（pyinstaller.log / build_installer.log）
#   release/shots/        产品介绍文档的界面底图（tools/docs/product-intro 采集）
#   release/win-unpacked/ 免安装产物；release/*-setup.exe 为 NSIS 安装包
# 回收空间 = 删掉整个 release/（scripts\清理发布目录.bat 先停占用再重建空目录）。
release/
# build/ 只留**手写**、不可重建的构建定义：installer.nsh 被 package.json 的
# electron-builder nsis.include 引用。目录级 build/ 规则曾把该文件一并吞掉（干净克隆
# 打不出安装包），故用 build/* + 取反精确放行；新产物不要再写进 build/。
build/*
!build/installer.nsh
# 历史遗留产物目录：旧脚本（build_desktop_installer.ps1）曾把 sidecar 输出到 dist/。
# 新链路已统一 release/exe/；规则保留，防止旧分支或旧脚本产物回流污染 git status。
dist/
out/
# publish.ps1 在缺少 release-notes-<版本>.md 时于仓库根生成的临时说明（构建产物，非文档）。
release-notes-*.auto.md
# 图标预览图由 `python scripts/make_icon.py` 每次重出（真源是 we_icon.ico），不入库。
assets/we_icon_preview.png
# ⚠ 不要写 `*.spec` 兜底：根目录 `工作量评估工具.spec` 是**手写**的 PyInstaller
# 构建定义（datas / hiddenimports / 图标口径与取舍注释都在其中），此前正是被
# `*.spec` 误忽略而长期未入库，新克隆因此打不出 sidecar exe。它属于源码，必须跟踪。

# ─── 运行时数据与日志 ────────────────────────────────────────────────
# data/ 整体忽略，仅放行「源码级」子目录与 AC-20 标注集：git 不会进入被排除的目录，
# 必须先让目录本身不被忽略，其下文件才谈得上 include。
data/*
# i18n 文案字典是**源码**（界面文案，随构建分发、启动时播种到 %APPDATA%）。
# 若随 data/ 一起忽略，其他机器与 CI 拿不到字典，且 _i18n_seed() 在打包态静默
# 落空 → 安装版翻译整体失效。
!data/i18n/
!data/i18n/*.json
# data/themes 是三层 Token 主题定义（源码级品牌资产，随构建分发给所有用户）。
!data/themes/
!data/themes/*.json
# data/testdocs 是回归夹具（S3/S4/S5/S6/S7/S8/S9 硬依赖 t00928_req.docx，
# 文件缺失时套件直接报错而非跳过）。不入库 = 新克隆与 CI 无法跑测试。
!data/testdocs/
!data/testdocs/*.docx
# data/eval_samples.json 是 AC-20 离线质量评测的源码级标注集（120 条）。
# 缺失时评测与门禁无法复现，必须随仓库分发，不按运行时数据忽略。
!data/eval_samples.json
logs/
*.log

